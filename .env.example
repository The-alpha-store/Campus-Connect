# Android reads these Gradle properties/environment variables at build time.
# Safe for the client only when this is the Supabase publishable/anon key.
# Never put SUPABASE_SERVICE_ROLE_KEY in Android, .env, or any client build.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Local-only UI preview with fake personas. Leave false for normal builds.
DEMO_MODE_ENABLED=false
