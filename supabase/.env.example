# Copy to supabase/.env (this file name is git-ignored) and fill in.
# Then run:  npx supabase secrets set --env-file supabase/.env
WEBHOOK_SECRET=put-a-long-random-string-here
# The Firebase service-account JSON squashed onto ONE line, wrapped in single quotes:
FCM_SERVICE_ACCOUNT='{"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"..."}'
